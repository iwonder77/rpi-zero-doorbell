# ═══════════════════════════════════════════════════════════════════════════
# Timer that triggers doorbell-restart.service
# ═══════════════════════════════════════════════════════════════════════════
#
# A .timer is systemd's cron. It must be named to MATCH the .service it
# triggers: doorbell-restart.timer -> doorbell-restart.service. That pairing
# is by filename, which is why both files share a stem.
#
# INSTALL:
#   sudo cp doorbell-restart.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now doorbell-restart.timer
#
# VERIFY (shows the next scheduled firing):
#   systemctl list-timers doorbell-restart.timer

[Unit]
Description=Restart the doorbell exhibit each morning before opening

[Timer]
OnCalendar=*-*-* 06:00:00
# ┗━━ Every day at 06:00 local time (the Pi's timezone is America/Denver,
#     set during imaging). Well before the museum opens.
#
#     Check that systemd parses this the way you expect:
#         systemd-analyze calendar "*-*-* 06:00:00"

Persistent=false
# ┗━━ "If the Pi was powered off when 06:00 passed, do NOT fire on next boot."
#
#     This matters. With Persistent=true (the common default people copy from
#     the internet), a Pi that is powered down overnight would see a MISSED
#     06:00 firing and immediately restart the exhibit service at boot --
#     right when it just finished starting. Pointless churn. We only want the
#     restart when the machine has genuinely been up all night.

[Install]
WantedBy=timers.target
# ┗━━ Timers attach to timers.target, not multi-user.target.
